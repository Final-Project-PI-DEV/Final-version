{% extends 'base.html.twig' %}

{% block title %}Password Reset Request{% endblock %}

{% block body %}
    <div class="email-container">
        <div class="email-wrapper">
            <h1 class="email-title">Hi!</h1>
            <p class="email-message">
                To reset your password, please visit the following link:
            </p>
            <div class="reset-link-wrapper">
                <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" class="reset-link">{{ url('app_reset_password', {token: resetToken.token}) }}</a>
            </div>
            <p class="email-message">
                This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p class="email-footer">
                Cheers!
            </p>
        </div>
    </div>

    <style>
        .email-container {
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f4f4f9;
        }

        .email-wrapper {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 600px;
            text-align: center;
        }

        .email-title {
            font-size: 28px;
            color: #333;
            margin-bottom: 15px;
        }

        .email-message {
            font-size: 16px;
            color: #555;
            margin-bottom: 20px;
        }

        .reset-link-wrapper {
            margin: 15px 0;
        }

        .reset-link {
            font-size: 18px;
            color: #007bff;
            text-decoration: none;
            border: 2px solid #007bff;
            padding: 10px 20px;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .reset-link:hover {
            background-color: #007bff;
            color: #fff;
            text-decoration: none;
        }

        .email-footer {
            font-size: 16px;
            color: #777;
            margin-top: 20px;
        }
    </style>
{% endblock %}
