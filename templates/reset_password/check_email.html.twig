{% extends 'base.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block body %}
    <div class="container">
        <div class="reset-password-wrapper">
            <h1 class="reset-password-title">Password Reset Email Sent</h1>
            <p class="reset-password-message">
                If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password.
                This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p class="reset-password-info">
                If you don't receive an email, please check your spam folder or <a href="{{ path('app_forgot_password_request') }}">try again</a>.
            </p>
        </div>
    </div>

    <style>
        .container {
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f5f5f5;
        }

        .reset-password-wrapper {
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 500px;
            width: 100%;
            text-align: center;
        }

        .reset-password-title {
            font-size: 24px;
            color: #333;
            margin-bottom: 20px;
        }

        .reset-password-message {
            font-size: 16px;
            color: #555;
            margin-bottom: 20px;
        }

        .reset-password-info {
            font-size: 14px;
            color: #777;
        }

        .reset-password-info a {
            color: #007bff;
            text-decoration: none;
        }

        .reset-password-info a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}
