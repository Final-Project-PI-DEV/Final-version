{% extends 'base.html.twig' %}

{% block title %}Modifier le Transport{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('assets/cssaziz/header.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/cssaziz/formevents.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/cssaziz/formtransport.css') }}">
    <style>
        :root {
            --primary-color: #ff8c00; /* 🎨 Couleur Orange */
            --dark-color: #cc7000; /* 🎨 Couleur foncée */
            --secondary-color: #ffffff; /* 🎨 Blanc */
        }

        .form-card {
            max-width: 800px; /* ✅ Largeur contrôlée */
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin: 2rem auto;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            height: auto;
            overflow: hidden;
        }

        .form-header {
            background: linear-gradient(135deg, var(--primary-color), var(--dark-color));
            color: white;
            padding: 1.5rem;
            text-align: center;
            border-radius: 15px 15px 0 0;
            font-size: 1.5rem;
            font-weight: bold;
        }

        .form-body {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
        }

        .form-group {
            margin-bottom: 1.8rem; /* ✅ Augmentation de l'espace entre les champs */
        }

        .form-control,
        .form-select {
            padding: 1rem; /* ✅ Champs plus spacieux */
            font-size: 1rem;
            border-radius: 10px;
            width: 100%;
            border: 2px solid #e0e0e0;
            margin-bottom: 1rem;
        }

        .flatpickr-input {
            border-radius: 0.375rem;
        }

        .is-invalid {
            border-color: #ff4444 !important;
            box-shadow: 0 0 0 0.2rem rgba(255, 68, 68, 0.25);
        }

        .btn-submit {
            background: linear-gradient(45deg, var(--primary-color), var(--dark-color)); /* ✅ Bouton couleur orange */
            border: none;
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(204, 112, 0, 0.3);
        }

        .btn-submit i {
            margin-right: 8px;
        }

        .back-link {
            font-size: 1rem;
            color: var(--primary-color);
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .d-flex.justify-content-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
        }

        /* ✅ Responsive: ajustement pour les petits écrans */
        @media (max-width: 768px) {
            .form-card {
                width: 90%;
                padding: 1.5rem;
            }

            .form-body {
                padding: 1rem;
            }

            .btn-submit {
                width: 100%; /* ✅ Le bouton prend toute la largeur sur mobile */
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="form-card">
        <div class="form-header">
            <h1 class="h3 mb-0">Modifier le Transport</h1>
        </div>

        <div class="form-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.typetransport, 'Type de Transport') }}
                            {{ form_widget(form.typetransport, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.typetransport) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.heure_depart, 'Heure de Départ') }}
                            {{ form_widget(form.heure_depart, {'attr': {'class': 'form-control flatpickr'}}) }}
                            {{ form_errors(form.heure_depart) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.heureArrive, 'Heure d\'Arrivée') }}
                            {{ form_widget(form.heureArrive, {'attr': {'class': 'form-control flatpickr'}}) }}
                            {{ form_errors(form.heureArrive) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.nbreescale, 'Nombre d\'Escales') }}
                            {{ form_widget(form.nbreescale, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.nbreescale) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.nbreplace, 'Nombre de Places') }}
                            {{ form_widget(form.nbreplace, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.nbreplace) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.matricule, 'Matricule') }}
                            {{ form_widget(form.matricule, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.matricule) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {
                                'class': 'form-control',
                                'rows': 4,
                                'style': 'resize: none;'
                            }}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.events, 'Événements Associés') }}
                            {{ form_widget(form.events, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.events) }}
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('dashboard') }}" class="back-link">
                        <i class="fas fa-arrow-left"></i>
                        Retour à la liste
                    </a>

                    <!-- ✅ Bouton Enregistrer aligné à droite -->
                    <div>
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-save"></i>
                            {{ button_label|default('Mettre à jour') }}
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
