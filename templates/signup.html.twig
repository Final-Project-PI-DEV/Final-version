{% extends 'base.html.twig' %}

{% block title %}Sign Up{% endblock %}

{% block body %}
    <section class="vh-100 d-flex align-items-center justify-content-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card shadow-2-strong p-4" style="border-radius: 1rem; background-color: rgba(255, 255, 255, 0.2);">
                        <div class="card-body text-center">
                            <img src="{{ asset('assets/images/logorz1.png') }}" alt="Logo" class="logo"/>
                            <h3 class="mb-4">Sign Up</h3>
                            <form method="post">
                                <div class="form-outline mb-3">
                                    <input type="text" id="firstName" name="first_name" class="form-control" required/>
                                    <label class="form-label" for="firstName">First Name</label>
                                </div>
                                <div class="form-outline mb-3">
                                    <input type="text" id="lastName" name="last_name" class="form-control" required/>
                                    <label class="form-label" for="lastName">Last Name</label>
                                </div>
                                <div class="form-outline mb-3">
                                    <div class="input-group">
                                        <select class="form-select" id="countryCode" name="country_code" required>
                                            <option value="+216">+216 (Tunisia)</option>
                                            <option value="+33">+33 (France)</option>
                                            <option value="+1">+1 (USA)</option>
                                            <!-- Add more country codes here -->
                                        </select>
                                        <input type="tel" id="phoneNumber" name="phone" class="form-control" required pattern="\\d*"/>
                                    </div>
                                    <label class="form-label" for="phoneNumber">Phone Number</label>
                                </div>
                                <div class="form-outline mb-3">
                                    <input type="email" id="email" name="email" class="form-control" required/>
                                    <label class="form-label" for="email">Email</label>
                                </div>
                                <div class="form-outline mb-3">
                                    <input type="password" id="password" name="password" class="form-control" required/>
                                    <label class="form-label" for="password">Password</label>
                                </div>
                                <div class="form-outline mb-3">
                                    <input type="password" id="confirmPassword" name="confirm_password" class="form-control" required/>
                                    <label class="form-label" for="confirmPassword">Repeat Password</label>
                                </div>
                                <button class="btn btn-primary btn-lg btn-block" type="submit">Sign Up</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <style>
        body, html {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        .vh-100 {
            background-image: url('{{ asset('assets/images/campnow.jpg') }}');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card {
            border: none;
            backdrop-filter: blur(10px);
        }
        .form-control {
            background-color: rgba(255, 255, 255, 0.7);
            color: black;
        }
        .btn-primary {
            background-color: #007bff;
        }
        .btn-primary:hover {
            background-color: #0056b3;
        }
        .logo {
            max-width: 80px;
            margin-bottom: 15px;
        }
        .form-label {
            color: #ec8401;
        }
    </style>
{% endblock %}

{% block javascripts %}
    <script>
        document.getElementById("phoneNumber").addEventListener("input", function (event) {
            this.value = this.value.replace(/[^0-9]/g, "");
        });
    </script>
{% endblock %}
