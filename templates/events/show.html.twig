{% block stylesheets %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2d6a4f;
            --secondary-color: #f5f5f5;
            --accent-color: #ffcc00;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f8f9fa;
        }

        /* ✅ EN-TÊTE DE L'ÉVÉNEMENT */
        .event-header {
            background: linear-gradient(135deg, var(--primary-color), #1e7740);
            color: white;
            padding: 4rem 2rem;
            border-radius: 0 0 50px 50px;
            text-align: center;
            position: relative;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .event-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            animation: fadeInUp 1s ease-in-out;
        }

        .event-header .event-badge {
            background: rgba(255, 255, 255, 0.15);
            padding: 0.7rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 1rem;
        }

        /* ✅ IMAGE D'ÉVÉNEMENT */
        .event-image {
            width: 100%;
            max-width: 700px;
            height: 400px;
            object-fit: cover;
            border-radius: 15px;
            display: block;
            margin: 3rem auto;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border: 3px solid white;
        }

        /* ✅ CARTES DÉTAILS */
        .detail-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            padding: 2rem;
            margin-bottom: 2rem;
            transition: transform 0.3s ease;
        }

        .detail-card:hover {
            transform: translateY(-5px);
        }

        .icon-box {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            background: var(--primary-color);
            color: white;
            margin-right: 1rem;
        }

        .info-item {
            padding: 1rem;
            border-radius: 10px;
            background: #f9f9f9;
            border-left: 5px solid var(--primary-color);
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
        }

        /* ✅ BOUTONS */
        .btn-gradient {
            background: linear-gradient(45deg, var(--primary-color), #1e7740);
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            display: inline-flex;
            align-items: center;
        }

        .btn-gradient i {
            margin-right: 8px;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(14, 94, 25, 0.3);
        }

        /* ✅ ANIMATION */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="event-header">
        <div class="container">
            <h1 class="fw-bold mb-3">{{ events.titre }}</h1>
            <div class="event-badge">{{ events.typeevent }}</div>
            <div class="text-white-50 mt-3">
                <i class="fas fa-map-marker-alt me-2"></i>{{ events.lieu }}
            </div>
        </div>
    </div>

    <div class="container">
        {% if events.image %}
            <img src="{{ asset('uploads/images/' ~ events.image) }}" class="event-image" alt="{{ events.titre }} image">
        {% endif %}

        <div class="row g-4">
            <!-- Colonne Gauche -->
            <div class="col-lg-6">
                <div class="detail-card">
                    <div class="section-title">
                        <div class="icon-box"><i class="fas fa-calendar-alt"></i></div>
                        Dates clés
                    </div>
                    
                    <div class="info-item">
                        <h5 class="fw-bold">Début</h5>
                        <p class="mb-0 text-muted">{{ events.dateDebut|date('d M Y H:i') }}</p>
                    </div>
                    
                    <div class="info-item">
                        <h5 class="fw-bold">Fin</h5>
                        <p class="mb-0 text-muted">{{ events.dateFin|date('d M Y H:i') }}</p>
                    </div>
                </div>
            </div>

            <!-- Colonne Droite -->
            <div class="col-lg-6">
                <div class="detail-card">
                    <div class="section-title">
                        <div class="icon-box"><i class="fas fa-info-circle"></i></div>
                        Informations pratiques
                    </div>

                    <div class="info-item">
                        <h5 class="fw-bold">Tarif</h5>
                        <p class="mb-0 text-muted">{{ events.prix }} DT</p>
                    </div>

                    <div class="info-item">
                        <h5 class="fw-bold">Film</h5>
                        <p class="mb-0 text-muted">{{ events.film }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="detail-card">
            <div class="section-title">
                <div class="icon-box"><i class="fas fa-align-left"></i></div>
                Description
            </div>
            <p class="lead text-muted lh-lg">{{ events.description }}</p>
        </div>

        <div class="text-center mt-5">
            <a href="{{ path('app_events_index') }}" class="btn btn-gradient">
                <i class="fas fa-arrow-left"></i> Retour aux événements
            </a>
        </div>
    </div>
{% endblock %}
