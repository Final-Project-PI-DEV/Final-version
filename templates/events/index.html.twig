<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Campers Dashboard</title>
		<link rel="shortcut icon" href="{{ asset('assets/images/logo.png') }}">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">

        <!-- Chart.js CDN -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	</head>
	<body>
		<header>
			<div class="logo" title="University Management System">
				<img src="{{ asset('assets/images/logo.png') }}" alt="">
			</div>
			<div class="navbar">
				<a href="{{ path('app_user_index') }}" onclick="timeTableAll()">
					<span class="material-icons-sharp">home</span>
					<h3>User</h3>
				</a>
				<a href="timetable.html" onclick="timeTableAll()">
					<span class="material-icons-sharp">event_available</span>
					<h3>RESERVATION</h3>
				</a>
				<a href="/restaurant" onclick="timeTableAll()">
					<span class="material-icons-sharp">restaurant</span>
					<h3>RESTAURANTS</h3>
				</a>
				<a href="/menu">
					<span class="material-icons-sharp">menu</span>
					<h3>MENU</h3>
				</a>
				<a href="/events" class="active">
					<span class="material-icons-sharp">events</span>
					<h3>events</h3>
				</a>
				<a href="/transport">
					<span class="material-icons-sharp">directions_bus</span>
					<h3>transports</h3>
				</a>
				<a href="{{ path('app_logout') }}">
					<span class="material-icons-sharp">logout</span>
					<h3>Logout</h3>
				</a>
			</div>

			<div id="profile-btn">
				<span class="material-icons-sharp">person</span>
			</div>
			<div class="theme-toggler">
				<span class="material-icons-sharp active">light_mode</span>
				<span class="material-icons-sharp">dark_mode</span>
			</div>
		</header>

		<div class="container">
			<aside>
				<div class="profile">
					<div class="top">
						<div class="profile-photo">
							<img src="{{ admin.image ? asset('uploads/' ~ admin.image) : asset('assets/images/default-avatar.png') }}" alt="User Photo">
						</div>
						<div class="info">
							<p>Hey, <b>{{ admin.nom ~ ' ' ~ admin.prenom }}</b></p>
							<small class="text-muted">{{ admin.id }}</small>
						</div>
					</div>
					<div class="about">
						<h5>Role</h5>
						<p>{% if 'ROLE_ADMIN' in admin.roles %} Admin Camper {% else %} Premium Camper {% endif %}</p>
						<h5>Birthday</h5>
						<p>{{ admin.dateDeNaissance ? admin.dateDeNaissance|date('d-M-Y') : 'Non renseigné' }}</p>
						<h5>Contact</h5>
						<p>{{ admin.telephone }}</p>
						<h5>Email</h5>
						<p>{{ admin.email }}</p>
						<h5>Address</h5>
						<p>{{ admin.adresse|default('Non renseignée') }}</p>
					</div>
				</div>
			</aside>

			<main>
				<h1>Gestion des Événements</h1>

				<!-- Statistiques des événements -->
				<div class="charts">
    <!-- Graphique circulaire pour les types d'événements -->
    <div class="chart-container" style="max-width: 400px; max-height: 400px; margin: auto">
        <h3>Répartition des événements par type</h3>
        <canvas id="eventTypeChart"></canvas>
    </div>

    <!-- Graphique linéaire pour l'évolution des événements créés -->
    <div class="chart-container" style="max-width: 600px; margin: 20px auto">
        <h3>Évolution des événements créés</h3>
        <canvas id="eventCreationChart"></canvas>
    </div>
</div>

				<!-- Ton tableau des événements -->
				<div class="timetable" id="timetable">
					<div>
						<span id="prevDay">&lt;</span>
						<h2>Table des évenement</h2>
						<span id="nextDay">&gt;</span>
						<div class="text-center mt-5">
							<a href="{{ path('app_events_new') }}" class="btn btn-primary btn-lg px-5">
								<i class="fas fa-plus-circle me-2"></i>
								Create New Event
							</a>
						</div>
					</div>
					<span class="closeBtn" onclick="timeTableAll()">X</span>
					<table>
						<thead>
							<tr>
								<th>Titre</th>
								<th>Type de l' évenement</th>
								<th>date de debut</th>
								<th>date fin</th>
								<th>Lieu</th>
								<th>Prix</th>
								<th>Image</th>
								<th>Film</th>

							</tr>
						</thead>
						<tbody>
							{% for event in events %}
								<tr>
									<td>{{ event.titre }}</td>
									<td>{{ event.typeevent }}</td>
									<td>{{ event.dateDebut ? event.dateDebut|date('d/m/Y') : '' }}</td>
									<td>{{ event.dateFin ? event.dateFin|date('d/m/Y') : '' }}</td>
									<td>{{ event.lieu }}</td>
									<td>{{ event.prix }}</td>
									<td>{{ event.image }}</td>
									<td>{{ event.film }}</td>
									<td></td>
									<td>
										<div
											style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
											<!-- Bouton Modifier -->
											<a href="{{ path('app_events_edit', {'id': event.id}) }}" class="btn btn-sm btn-primary" style="padding: 6px 12px; border-radius: 5px; text-decoration: none;">
												<i class="fas fa-edit"></i>
												Modifier
											</a>

											<!-- Bouton Supprimer -->
											<form action="{{ path('app_events_delete', {'id': event.id}) }}" method="POST" style="margin: 0;">
												<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
												<button type="submit" class="btn btn-sm btn-danger" style="padding: 6px 12px; border-radius: 5px;" onclick="return confirm('Êtes-vous sûr ?')">
													<i class="fas fa-trash"></i>
													Supprimer
												</button>
											</form>

											<!-- Bouton Show -->
											<a href="{{ path('app_dash_show', {'id': event.id}) }}" class="btn btn-sm btn-success" style="padding: 6px 12px; border-radius: 5px; text-decoration: none;">
												<i class="fas fa-eye"></i>
												Voir
											</a>
											<style>
												.btn {
													transition: all 0.3s ease;
													display: inline-flex;
													align-items: center;
													gap: 6px;
												}

												.btn-primary {
													background: #4a90e2;
													border: 1px solid #357abd;
												}

												.btn-danger {
													background: #e63946;
													border: 1px solid #c5303b;
												}

												.btn-success {
													background: #52b788;
													border: 1px solid #40916c;
												}

												.btn:hover {
													transform: translateY(-1px);
													box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
												}

												.btn-sm {
													font-size: 0.875rem;
												}

												.fas {
													font-size: 0.9rem;
												}
											</style>
										</div>
									</td>
								</tr>
							</td>
						</tbody>
					</tr>
				{% else %}
					<tr>
						<td colspan="4">No events found for today</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</body>
</html></div><div class="timetable" id="timetable">

		<script>
			// Graphique circulaire : Répartition par type d'événements
			var ctx1 = document.getElementById('eventTypeChart').getContext('2d');
			var eventTypeChart = new Chart(ctx1, {
				type: 'pie', 
				data: {
					labels: {{ eventTypes|json_encode()|raw }},
					datasets: [{
						data: {{ eventCounts|json_encode()|raw }},
						backgroundColor: ['#FF5733', '#33FF57', '#3357FF', '#FF33A6', '#A6FF33'],
						borderColor: '#fff',
						borderWidth: 1
					}]
				},
				options: {
					responsive: true,
					
					plugins: {
						legend: {
							position: 'top',
						},
						tooltip: {
							callbacks: {
								label: function(tooltipItem) {
									return tooltipItem.label + ': ' + tooltipItem.raw + ' événements';
								}
							}
						}
					}
					
				}
			});

			// Graphique linéaire : Nombre d'événements créés par mois
			var ctx2 = document.getElementById('eventCreationChart').getContext('2d');
    var eventCreationChart = new Chart(ctx2, {
        type: 'line',
        data: {
            labels: {{ months|json_encode()|raw }},
            datasets: [{
                label: 'Événements créés',
                data: {{ monthlyEventCounts|json_encode()|raw }},
                borderColor: '#4CAF50',
                backgroundColor: 'rgba(76, 175, 80, 0.2)',
                borderWidth: 2,
                fill: true
            }]
        },
        options: {
            responsive: true,
            scales: {
                  y: {
                beginAtZero: true, // Commence à zéro
                ticks: {
                    stepSize: 1, // Pas de 1 entre les ticks
                    // Désactive l'auto-saut des ticks
                }
            }
				
            }
        }
    });
		</script>

		<script src="{{ asset('assets/js/timeTable.js') }}"></script>
		<script src="{{ asset('assets/js/app.js') }}"></script>
	</body>
</html>
