{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Rahalla.tn{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}">
    <style>
        /* Custom CSS for the profile page */
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .user-profile {
            width: 100%;
            max-width: 800px; /* Adjust the max-width as needed */
            padding: 20px;
        }

        .profile-card {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 30px;
        }

        .profile-header img {
            border: 5px solid #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .profile-header h3 {
            font-size: 24px;
            font-weight: bold;
            margin-top: 15px;
        }

        .profile-header p {
            font-size: 16px;
            color: #666;
        }

        .profile-details h5 {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #333;
        }

        .profile-details ul {
            padding-left: 0;
        }

        .profile-details ul li {
            margin-bottom: 10px;
            font-size: 16px;
            color: #555;
        }

        .profile-details ul li strong {
            color: #333;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        .btn-danger {
            background-color: #dc3545;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        @media (max-width: 768px) {
            .profile-card {
                padding: 20px;
            }

            .profile-header img {
                width: 100px;
                height: 100px;
            }

            .profile-header h3 {
                font-size: 20px;
            }

            .profile-header p {
                font-size: 14px;
            }

            .profile-details h5 {
                font-size: 16px;
            }

            .profile-details ul li {
                font-size: 14px;
            }

            .btn-primary, .btn-danger {
                font-size: 14px;
                padding: 8px 16px;
            }
        }

        .profile-header {
            margin-bottom: 30px;
            text-align: center;
        }

        .profile-details {
            margin-top: 20px;
        }

        .text-center.mt-4 {
            margin-top: 30px;
            text-align: center;
        }
    </style>
{% endblock %}

{% block body %}
    <section id="user-profile" class="user-profile section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10">
                    <div class="profile-card">
                        <div class="profile-header">
                            {% if user.image %}
                                <img src="{{ asset('uploads/' ~ user.image) }}" alt="User Avatar" class="rounded-circle" width="150" height="150">
                            {% else %}
                                <img src="{{ asset('assets/images/default-avatar.png') }}" alt="Default Avatar" class="rounded-circle" width="150" height="150">
                            {% endif %}
                            <h3 class="mt-3">{{ user.nom }}</h3>
                            <p class="text-muted">{{ user.email }}</p>
                        </div>
                        <div class="profile-details">
                            <div class="row justify-content-center">
                                <div class="col-12 col-md-6">
                                    <h5><i class="bi bi-person-lines-fill"></i> Coordonnées</h5>
                                    <ul class="list-unstyled">
                                        <li><i class="bi bi-telephone"></i> <strong>Téléphone :</strong> {{ user.telephone ?? 'Non renseigné' }}</li>
                                        <li><i class="bi bi-envelope"></i> <strong>Email :</strong> {{ user.email }}</li>
                                        <li><i class="bi bi-geo-alt"></i> <strong>Adresse :</strong> {{ user.adresse ?? 'Non renseignée' }}</li>
                                    </ul>
                                </div>
                                <div class="col-12 col-md-6">
                                    <ul class="list-unstyled">
                                        <li><i class="bi bi-person"></i> <strong>Rôle principal :</strong> {{ user.roles ? user.roles|join(', ') : 'Utilisateur' }}</li>
                                        <li><i class="bi bi-circle-fill"></i> <strong>Status :</strong> {{ user.isActive ? 'Actif' : 'Inactif' }}</li>
                                        <li><i class="bi bi-circle-fill"></i> <strong>Date de Date_de_naissance :</strong> {{ user.dateDeNaissance ? user.dateDeNaissance|date('Y-m-d') : '' }}</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">Modifier le profil</a>
                            <a href="{{path('app_logout')}}" class="btn btn-danger">Se déconnecter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}