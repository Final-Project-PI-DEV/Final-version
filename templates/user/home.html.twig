				<script>
					let lastScrollTop = 0; // Keep track of the last scroll position
const header = document.getElementById('header');

window.addEventListener('scroll', function () {
const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

// If scrolling down, hide the header; if scrolling up, show it
if (scrollTop > lastScrollTop) { // Downscroll
header.style.top = "-100px"; // Adjust this value based on your header height
} else { // Upscroll
header.style.top = "0"; // Show the header
} lastScrollTop = scrollTop; // Update last scroll position
});
				</script>
				<script>
					// Smooth scrolling for anchor links
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
anchor.addEventListener('click', function (e) {
e.preventDefault();
const target = document.querySelector(this.getAttribute('href'));
if (target) {
target.scrollIntoView({behavior: 'smooth'});
}
});
});
				</script>
				<script>
					// Initialisation de Swiper
var swiper = new Swiper('.mySwiper', {
loop: true, // Permet la navigation en boucle
slidesPerView: 3, // Nombre de slides visibles à la fois
spaceBetween: 30, // Espacement entre les slides
navigation: {
nextEl: '.swiper-button-next', // Bouton pour aller à la slide suivante
prevEl: '.swiper-button-prev', // Bouton pour revenir à la slide précédente
},
pagination: {
el: '.swiper-pagination', // Élément de pagination
clickable: true, // Rendre la pagination cliquable
}
});
				</script>

