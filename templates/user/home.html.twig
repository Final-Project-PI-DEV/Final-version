					}
					.swiper-container {
						width: 100%;
						padding-top: 50px;
						padding-bottom: 50px;
					}

					.swiper-slide {
						display: flex;
						justify-content: center;
						align-items: center;
						background-color: #f3f3f3;
						border-radius: 10px;
						height: 300px;
						text-align: center;
					}
