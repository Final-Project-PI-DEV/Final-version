	<script>
		document.addEventListener('DOMContentLoaded', function () {
function handleTranslation(button) {
try { // Try to get the parent element with class 'card-text'; fallback to button's parent if not found
const contentEl = button.closest('.card-text') || button.parentElement;
if (! contentEl) {
throw new Error('Content element not found');
}
const postId = button.dataset.postId;
const content = button.dataset.content;
const langSelect = contentEl.querySelector('.translate-lang');
if (! langSelect) {
throw new Error('Language selector not found');
}
const targetLang = langSelect.value;
// Store the original content HTML
const originalContent = contentEl.innerHTML;

// Show loading state
button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Translating...';
button.disabled = true;

// Make the translation request
fetch('/translate-post', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{content: content, targetLang: targetLang}
)
}).then(response => {
if (!response.ok) 
throw new Error('Network response was not ok');



return response.json();
}).then(data => {
if (data.error) 
throw new Error(data.error);



// Build new content while preserving the container
const translatedContent = `
                    <div class="translation-content">${
data.translation
}</div>
                    <div class="d-inline-flex align-items-center mt-2">
                        <select class="form-select form-select-sm me-2 translate-lang" style="width: auto;">
                            <option value="fr">Français</option>
                            <option value="en">English</option>
                            <option value="ar">العربية</option>
                            <option value="es">Español</option>
                            <option value="de">Deutsch</option>
                        </select>
                        <button class="btn btn-sm btn-outline-secondary translate-btn"
                                data-post-id="${postId}"
                                data-content="${content}"
                                data-original="${
encodeURIComponent(originalContent)
}">
                            <i class="fas fa-language"></i> Show Original
                        </button>
                    </div>`;
// Update the inner HTML of the container
contentEl.innerHTML = translatedContent;
initializeTranslationHandlers();
}).catch(error => {
console.error('Translation error:', error);
button.innerHTML = '<i class="fas fa-language"></i> Translation failed';
Swal.fire({icon: 'error', title: 'Translation Failed', text: error.message});
}). finally(() => {
button.disabled = false;
});
} catch (error) {
console.error('Translation handling error:', error);
Swal.fire({icon: 'error', title: 'Error', text: error.message});
}
}

function handleShowOriginal(button) {
try {
const contentEl = button.closest('.card-text') || button.parentElement;
if (! contentEl) {
throw new Error('Content element not found');
}
const originalContent = decodeURIComponent(button.dataset.original);
contentEl.innerHTML = originalContent;
initializeTranslationHandlers();
} catch (error) {
console.error('Show original error:', error);
Swal.fire({icon: 'error', title: 'Error', text: error.message});
}
}

function initializeTranslationHandlers() {
document.querySelectorAll('.translate-btn').forEach(button => {
button.addEventListener('click', function (e) {
e.preventDefault();
if (this.dataset.original) {
handleShowOriginal(this);
} else {
handleTranslation(this);
}
});
});
}

// Initial setup
initializeTranslationHandlers();
});
	</script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
const translateAllBtn = document.getElementById('translate-all-btn');
const showOriginalAllBtn = document.getElementById('show-original-all-btn');
const globalLangSelect = document.getElementById('global-translate-lang');

// Function to translate a single element using your endpoint
async function translateElement(el, targetLang) {
const originalContent = el.getAttribute('data-full-content');
try {
const response = await fetch('/translate-post', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{content: originalContent, targetLang: targetLang}
)
});
if (! response.ok) 
throw new Error('Network response was not ok');


const data = await response.json();
if (data.error) 
throw new Error(data.error);


// Save original content into a data attribute in case we want to revert later
el.setAttribute('data-original', originalContent);
// Replace the element's content with the translation
el.innerHTML = data.translation;
} catch (error) {
console.error('Translation error for an element:', error);
// Optionally, show error feedback
}
}

// Handler for Translate All Posts
translateAllBtn.addEventListener('click', async (e) => {
e.preventDefault();
const targetLang = globalLangSelect.value;
const postElements = document.querySelectorAll('.card-text[data-full-content]');
// Optionally disable the button during translation
translateAllBtn.disabled = true;
for (const el of postElements) {
await translateElement(el, targetLang);
}
// Show "Show All Originals" button after translation
showOriginalAllBtn.classList.remove('d-none');
translateAllBtn.disabled = false;
});

// Handler for restoring original text in all posts
showOriginalAllBtn.addEventListener('click', (e) => {
e.preventDefault();
const postElements = document.querySelectorAll('.card-text[data-original]');
postElements.forEach(el => {
const original = el.getAttribute('data-original');
if (original) {
el.innerHTML = original.slice(0, 100) + '...';
}
});
// Hide the "Show All Originals" button again
showOriginalAllBtn.classList.add('d-none');
});
});



