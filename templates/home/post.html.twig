{% extends 'base2.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center mb-4">{{ post is defined and post.id is not null ? 'Modifier un post' : 'Créer un post' }}</h1>
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'form'}}) }}

        <!-- Lieu Field -->
        <div class="form-group mb-4">
            {{ form_label(form.lieu, 'Lieu', {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-wrapper">
                {{ form_widget(form.lieu, {'attr': {'class': 'form-control modern-input', 'placeholder': 'Entrez le lieu', 'autocomplete': 'on'}}) }}
                <i class="fas fa-map-marker-alt input-icon"></i>
            </div>
            {{ form_errors(form.lieu) }}
        </div>

        <!-- Title Field -->
        <div class="form-group mb-4">
            {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-wrapper">
                {{ form_widget(form.title, {'attr': {'class': 'form-control modern-input', 'placeholder': 'Entrez le titre', 'autocomplete': 'off'}}) }}
                <i class="fas fa-heading input-icon"></i>
            </div>
            {{ form_errors(form.title) }}
        </div>

        <!-- Content Field -->
        <div class="form-group mb-4">
            {{ form_label(form.content, 'Contenu', {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-wrapper">
                {{ form_widget(form.content, {'attr': {'class': 'form-control modern-input modern-textarea', 'rows': 5, 'placeholder': 'Entrez le contenu'}}) }}
                <i class="fas fa-align-left input-icon textarea-icon"></i>
            </div>
            {{ form_errors(form.content) }}
        </div>

        <!-- Image Upload Field -->
               <div class="form-group mb-4 d-flex align-items-center gap-4">
           <div class="form-group">
                {{ form_widget(form.submit, {
                    'label': post is defined and post.id is not null ? 'Modifier' : 'Publier',
                    'attr': {'class': 'btn btn-custom px-5'}
                }) }}
            </div>

            <div class="file-upload-wrapper" style="max-width: 400px; margin: 0 auto;">
                {{ form_label(form.image, 'Télécharger une image', {'label_attr': {'class': 'custom-file-upload'}}) }}
                {{ form_widget(form.image, {'attr': {'class': 'file-upload-input', 'onchange': 'updateFileName(this)'}}) }}
                <div class="upload-area text-center p-4">
                    <i class="fas fa-cloud-upload-alt fa-3x mb-3" style="color: #4CAF50;"></i>
                    <p class="mb-1">Glissez-déposez votre fichier ici ou</p>
                    <span class="btn btn-success px-4">Parcourir</span>
                    <p class="file-name mt-2 text-muted"></p>
                </div>
                {{ form_errors(form.image) }}
            </div>
        </div>
        <!-- Submit Button -->
        {{ form_end(form) }}
    </div>

    <style>
        /* General Styles */
        .form-label {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.5rem;
        }

        .input-wrapper {
            position: relative;
        }

        .modern-input {
            width: 100%;
            padding: 12px 40px 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s ease;
            background-color: #f9f9f9;
        }

        .modern-input:focus {
            border-color: #4CAF50;
            box-shadow: 0 0 8px rgba(76, 175, 80, 0.3);
            background-color: #fff;
        }

        .modern-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .input-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #888;
            font-size: 18px;
            pointer-events: none;
        }

        .textarea-icon {
            top: 20px;
            transform: none;
        }

        /* File Upload Styles (Existing) */
        .custom-file-upload {
            display: none;
        }

        .file-upload-wrapper {
            position: relative;
            border: 2px dashed #4CAF50;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .file-upload-wrapper:hover {
            border-color: #45a049;
            background-color: #f8fff9;
        }

        .file-upload-input {
            opacity: 0;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            cursor: pointer;
        }

        .upload-area {
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .upload-area:hover {
            transform: translateY(-2px);
        }

        .btn-success {
            background-color: #4CAF50;
            border-color: #4CAF50;
            transition: all 0.3s ease;
        }

        .btn-success:hover {
            background-color: #45a049;
            border-color: #45a049;
        }

        .file-name {
            font-size: 0.9em;
            word-break: break-word;
        }
         .btn-custom {
        background-color: #45a049; /* Change this to your desired color */
        border-color: #45a049;
        color: #fff;
        font-weight: 600;
        padding: 10px 30px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-custom:hover {
        background-color:rgb(9, 125, 46);
       
        transform: translateY(-2px);
    }

    .btn-custom:active {
        background-color: #E83A2D;
        border-color: #E83A2D;
        transform: translateY(0);
    }
    </style>

    <script>
        function updateFileName(input) {
            const fileName = input.files[0]?.name || 'Aucun fichier sélectionné';
            const fileNameElement = input.closest('.file-upload-wrapper').querySelector('.file-name');
            fileNameElement.textContent = fileName;
        }

        // Handle drag and drop
        document.querySelector('.file-upload-wrapper').addEventListener('dragover', (e) => {
            e.preventDefault();
            e.currentTarget.style.borderColor = '#45a049';
        });

        document.querySelector('.file-upload-wrapper').addEventListener('dragleave', (e) => {
            e.preventDefault();
            e.currentTarget.style.borderColor = '#4CAF50';
        });

        document.querySelector('.file-upload-wrapper').addEventListener('drop', (e) => {
            e.preventDefault();
            e.currentTarget.style.borderColor = '#4CAF50';
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                document.querySelector('.file-upload-input').files = files;
                updateFileName(document.querySelector('.file-upload-input'));
            }
        });
    </script>
{% endblock %}