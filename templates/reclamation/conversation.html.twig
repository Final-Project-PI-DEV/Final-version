{% extends 'base.html.twig' %}

{% block title %}Conversation -
	{{ reclamation.title }}
{% endblock %}

{% block body %}
	<div class="conversation-container">
		<div
			class="conversation-content">
			<!-- En-tête -->
			<div class="conversation-header card">
				<div class="header-content">
					<h1>{{ reclamation.title }}</h1>
					<div class="status-badge">
						<span class="badge {% if reclamation.statut == 'En cours' %}badge-warning{% elseif reclamation.statut == 'Résolu' %}badge-success{% else %}badge-secondary{% endif %}">
							{{ reclamation.statut }}
						</span>
					</div>
					<p class="description">{{ reclamation.description }}</p>
				</div>
			</div>

			<!-- Messages -->
			<div class="messages-section card">
				<div class="messages-container">
					{% if messages|length > 0 %}
						{% for message in messages %}
							<div class="message-wrapper {% if message.user.id == app.user.id %}sent{% else %}received{% endif %}">
								<div class="message">
									<div class="message-header">
										<span class="user-name">{{ message.user.getPrenom()|capitalize }}
											{{ message.user.getNom()|capitalize }}</span>
										<span class="message-time">{{ message.createdAt|date('H:i') }}</span>
									</div>
									<div class="message-content">
										{{ message.content }}
									</div>
									<div class="message-footer">
										<small class="message-date">{{ message.createdAt|date('d/m/Y') }}</small>
									</div>
								</div>
							</div>
						{% endfor %}
					{% else %}
						<div class="no-messages">
							<i class="fas fa-comments"></i>
							<p>Aucun message pour le moment</p>
						</div>
					{% endif %}
				</div>
			</div>

			<!-- Formulaire de réponse -->
			<div class="reply-section card">
				<form action="{{ path('conversation', { id: reclamation.id }) }}" method="POST">
					<div class="form-group">
						<textarea name="message" placeholder="Écrivez votre message..." required></textarea>
						<button type="submit" class="send-button">
							<i class="fas fa-paper-plane"></i>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<style>
		.conversation-container {
			min-height: 100vh;
			background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
			padding: 2rem 1rem;
		}

		.conversation-content {
			max-width: 800px;
			margin: 0 auto;
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}

		.card {
			background: white;
			border-radius: 15px;
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
			padding: 1.5rem;
			border: none;
		}

		/* En-tête */
		.conversation-header {
			text-align: center;
		}

		.conversation-header h1 {
			font-size: 1.8rem;
			color: #2c3e50;
			margin-bottom: 1rem;
		}

		.status-badge {
			margin-bottom: 1rem;
		}

		.badge {
			padding: 0.5rem 1rem;
			font-size: 0.9rem;
			border-radius: 50px;
		}

		.badge-warning {
			background-color: #ffd700;
			color: #000;
		}

		.badge-success {
			background-color: #28a745;
			color: white;
		}

		.badge-secondary {
			background-color: #6c757d;
			color: white;
		}

		.description {
			color: #666;
			font-size: 1rem;
			line-height: 1.5;
		}

		/* Messages */
		.messages-section {
			flex-grow: 1;
		}

		.messages-container {
			max-height: 500px;
			overflow-y: auto;
			padding: 1rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.message-wrapper {
			display: flex;
			margin-bottom: 1rem;
		}

		.message-wrapper.sent {
			justify-content: flex-end;
		}

		.message {
			max-width: 70%;
			padding: 1rem;
			border-radius: 15px;
			position: relative;
		}

		.message-wrapper.sent .message {
			background-color: #007bff;
			color: white;
			border-bottom-right-radius: 5px;
		}

		.message-wrapper.received .message {
			background-color: #f8f9fa;
			color: #333;
			border-bottom-left-radius: 5px;
		}

		.message-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.5rem;
			font-size: 0.9rem;
		}

		.message-content {
			margin-bottom: 0.5rem;
			line-height: 1.4;
		}

		.message-footer {
			text-align: right;
			font-size: 0.8rem;
			opacity: 0.8;
		}

		.no-messages {
			text-align: center;
			color: #666;
			padding: 2rem;
		}

		.no-messages i {
			font-size: 3rem;
			margin-bottom: 1rem;
			color: #ccc;
		}

		/* Formulaire de réponse */
		.reply-section {
			margin-top: auto;
		}

		.form-group {
			position: relative;
		}

		textarea {
			width: 100%;
			padding: 1rem 4rem 1rem 1rem;
			border: 2px solid #e9ecef;
			border-radius: 15px;
			resize: none;
			height: 100px;
			font-size: 1rem;
			transition: all 0.3s ease;
		}

		textarea:focus {
			outline: none;
			border-color: #007bff;
			box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
		}

		.send-button {
			position: absolute;
			right: 1rem;
			bottom: 1rem;
			background: #007bff;
			color: white;
			border: none;
			width: 40px;
			height: 40px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: all 0.3s ease;
		}

		.send-button:hover {
			background: #0056b3;
			transform: scale(1.1);
		}

		/* Responsive */
		@media(max-width: 768px) {
			.conversation-container {
				padding: 1rem 0.5rem;
			}

			.message {
				max-width: 85%;
			}

			.card {
				padding: 1rem;
			}
		}
	</style>
{% endblock %}
