<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<title>Réclamations</title>

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('assets/css/contact.css') }}">
	<link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
	<style>
		.faq {
			background: rgba(128, 128, 128, 0.49) no-repeat center center;
			background-size: cover;
			color: white;
			padding: 20px;
		}

		.faq-item {
			margin-bottom: 15px;
		}

		.faq-item h3 {
			color: rgb(0, 0, 0);
		}

		.section-space {
			height: 50px; /* Ajoute un espace entre les sections */
		}
	</style>
{% endblock %}

{% block body %}
{{include('reclamation/index1.html.twig')}}

	<script>
		let lastScrollTop = 0;
const header = document.getElementById('header');

window.addEventListener('scroll', function () {
const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
if (scrollTop > lastScrollTop) {
header.style.top = "-100px";
} else {
header.style.top = "0";
} lastScrollTop = scrollTop;
});
	</script>

	<div class="content">
		<section class="contact text-center" style="margin-bottom: 15px;">
			<h4>N'HÉSITEZ PAS À</h4>
			<h1>NOUS CONTACTER</h1>
		</section>

		<div class="container mt-4">
			<div class="row justify-content-center">
				<div class="col-md-8 col-lg-6">
					{{ form_start(form) }}
					<div class="form-group">
						{{ form_label(form.title) }}
						{{ form_widget(form.title, {'attr': {'class': 'form-control', 'style': 'background-color:rgba(255, 255, 255, 0.69); color: black;'}}) }}
						<div class="form-errors">{{ form_errors(form.title) }}</div>
					</div>
					<div class="form-group">
						{{ form_label(form.objet) }}
						{{ form_widget(form.objet, {'attr': {'class': 'form-control', 'style': 'background-color:rgba(255, 255, 255, 0.69);'}}) }}
						<div class="form-errors">{{ form_errors(form.objet) }}</div>
					</div>
					<div class="form-group">
						{{ form_label(form.description) }}
						{{ form_widget(form.description, {'attr': {'class': 'form-control', 'style': 'background-color:rgba(255, 255, 255, 0.69); color: Black;'}}) }}
						<div class="form-errors">{{ form_errors(form.description) }}</div>
					</div>

					<!-- Bouton Envoyer -->
					<div class="text-center mt-3">
						{{ form_widget(form.Envoyer, {'attr': {'class': 'btn', 'style': 'background-color: #ff7b00; color: white; border: none;'}}) }}
					</div>
					{{ form_end(form) }}
				</div>
			</div>
		</div>

		<!-- Section vide pour créer un espace avant la FAQ -->
		<div class="section-space"></div>

		<section class="faq">
			<h4>QUESTIONS COURANTES</h4>
			<div class="faq-item">
				<h3>Comment vous rejoindre ?</h3>
				<p>Pour intégrer la communauté, inscrivez-vous à un événement en vous rendant sur la page événements !</p>
			</div>
			<div class="faq-item">
				<h3>Comment être tenu(e) au courant des événements ?</h3>
				<p>Suivez-nous sur nos réseaux sociaux Rahalla.</p>
			</div>
			<div class="faq-item">
				<h3>Quel matériel dois-je prévoir ?</h3>
				<p>Nous recommandons des chaussures de randonnée, une bouteille d'eau et une tenue adaptée.</p>
			</div>
			<div class="faq-item">
				<h3>Je ne suis pas motorisé(e), comment faire pour participer ?</h3>
				<p>Nous organisons des bus, contactez-nous pour plus d'infos.</p>
			</div>
			<div class="faq-item">
				<h3>Quels sont vos tarifs pour un camping, pour une randonnée ?</h3>
				<p>Les tarifs varient selon l'événement, consultez notre site pour plus d'informations.</p>
			</div>
			<div class="faq-item">
				<h3>Est-ce que vous organisez des événements partout en Tunisie ?</h3>
				<p>Pour l’instant nous couvrons 12 régions en Tunisie.</p>
			</div>
			<div class="faq-item">
				<h3>Comment assurez-vous la sécurité dans la nature ?</h3>
				<p>L’équipe est formée en secourisme et prête à intervenir en cas d’urgence.</p>
			</div>
		</section>
	</div>

{% endblock %}

{% block javascripts %}
	<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
	<script src="{{ asset('assets/js/contact.js') }}"></script>
{% endblock %}
