{% block javascripts %}
	<script>
		// Questions du questionnaire
const questions = [
"Avez-vous trouvé le processus de soumission de réclamation facile à comprendre ?",
"Le temps de réponse à votre réclamation était-il satisfaisant ?",
"Les solutions proposées ont-elles répondu à vos attentes ?",
"Recommanderiez-vous notre service de réclamation à d'autres clients ?",
"La communication tout au long du processus était-elle claire ?"
];

let currentQuestion = 0;
let answers = [];

// Fonction pour démarrer le questionnaire
function startQuestionnaire() {
const chatMessages = document.getElementById('chatMessages');
chatMessages.innerHTML = '';
askQuestion();
}

// Fonction pour afficher une question
function askQuestion() {
if (currentQuestion < questions.length) {
const chatMessages = document.getElementById('chatMessages');
const messageDiv = document.createElement('div');
messageDiv.className = 'message bot-message';
messageDiv.textContent = questions[currentQuestion];
chatMessages.appendChild(messageDiv);

document.getElementById('responseButtons').style.display = 'flex'; /* Afficher les boutons en flex */
chatMessages.scrollTop = chatMessages.scrollHeight;
} else {
finishQuestionnaire();
}
}

// Fonction pour soumettre une réponse
function submitAnswer(isTrue) {
const chatMessages = document.getElementById('chatMessages');
const messageDiv = document.createElement('div');
messageDiv.className = 'message user-message';
messageDiv.textContent = isTrue ? 'Vrai' : 'Faux';
chatMessages.appendChild(messageDiv);

answers.push(isTrue);
currentQuestion++;

setTimeout(() => {
if (currentQuestion < questions.length) {
askQuestion();
} else {
finishQuestionnaire();
}
}, 500);
}

// Fonction pour terminer le questionnaire
function finishQuestionnaire() {
const chatMessages = document.getElementById('chatMessages');
document.getElementById('responseButtons').style.display = 'none';

const messageDiv = document.createElement('div');
messageDiv.className = 'message bot-message';
messageDiv.textContent = 'Merci pour vos réponses ! Vos avis nous aident à améliorer nos services.';
chatMessages.appendChild(messageDiv);

// Envoyer les résultats au serveur
fetch('{{ path('app_save_avis') }}', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{answers: answers, reclamationId: '{{ reclamation_id }}'}
)
});
}

// Démarrer le questionnaire au chargement de la page
window.onload = startQuestionnaire;
	</script>
{% endblock %}
