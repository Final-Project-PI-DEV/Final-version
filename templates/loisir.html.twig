<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panier Camping et Loisirs</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f4f4;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 90%;
            margin: 50px auto;
            max-width: 1200px;
        }

        h1 {
            text-align: center;
            font-size: 3em;
            margin-bottom: 40px;
            font-weight: bold;
            color: #333;
        }

        .section {
            margin-bottom: 60px;
        }

        .section h2 {
            font-size: 2em;
            color: #FF883B;
            text-align: center;
            margin-bottom: 20px;
        }

        .item-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .item {
            background-color: #fff;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            text-align: center;
            border: 1px solid #ddd;
            position: relative;
            height: 280px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .item:hover {
            transform: translateY(-10px);
            box-shadow: 0 6px 30px rgba(0, 0, 0, 0.2);
        }

        .item h3 {
        font-size: 1.2em;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .item p {
            font-size: 0.85em;
            color: #666;
            margin-bottom: 40px;
            position: absolute;
            bottom: 15px;
            left: 20px;
            right: 20px;
            font-size: 0.9em;
            background-color: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 8px;
            border-radius: 5px;
            display: none;
        }

        .item:hover p {
            display: block;
        }

        .button-container {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 10px;
        }

        .button {
            padding: 8px 16px;
            font-size: 1em;
            color: #fff;
            background-color: #FF883B;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .button:hover {
            background-color: #E8722F;
        }

        .cart {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            position: fixed;
            top: 100px;
            right: 20px;
            width: 300px;
            max-height: 500px;
            overflow-y: auto;
            z-index: 1000;
        }

        .cart h2 {
            font-size: 1.5em;
            margin-bottom: 15px;
            text-align: center;
        }

        .cart-item {
            margin: 5px 0;
            font-size: 1.1em;
            color: #444;
        }

        .total {
            margin-top: 20px;
            font-size: 1.2em;
            font-weight: bold;
            color: #FF883B;
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            font-size: 1.1em;
            color: #777;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Panier Camping et Loisirs</h1>

        <!-- Section matériel de camping -->
        <div class="section">
            <h2>Matériel de Camping</h2>
            <div class="item-list">
                <div class="item">
                    <h3><i class="fas fa-tent"></i> Tente</h3>
                    <p>Pour l'abri. Prix: 80DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Tente', 80, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Tente', 80, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-bed"></i> Sac de Couchage</h3>
                    <p>Pour dormir confortablement. Prix: 40DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Sac de Couchage', 40, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Sac de Couchage', 40, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-mattress-pillow"></i> Matelas de Camping</h3>
                    <p>Pour un meilleur confort de sommeil. Prix: 50DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Matelas de Camping', 50, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Matelas de Camping', 50, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-camping"></i> Réchaud de Camping</h3>
                    <p>Pour cuisiner. Prix: 30DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Réchaud de Camping', 30, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Réchaud de Camping', 30, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-utensils"></i> Casseroles et Poêles</h3>
                    <p>Pour préparer les repas. Prix: 25DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Casseroles et Poêles', 25, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Casseroles et Poêles', 25, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-glass-cheers"></i> Vaisselle</h3>
                    <p>Assiettes, verres, couverts. Prix: 15DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Vaisselle', 15, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Vaisselle', 15, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-ice-cream"></i> Glacière</h3>
                    <p>Pour garder les aliments au frais. Prix: 35DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Glacière', 35, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Glacière', 35, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-lightbulb"></i> Lampe de Poche</h3>
                    <p>Pour éclairer la nuit. Prix: 20DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Lampe de Poche', 20, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Lampe de Poche', 20, 'matériel')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-hand-sparkles"></i> Trousse de Premiers Secours</h3>
                    <p>Pour les urgences. Prix: 30DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Trousse de Premiers Secours', 30, 'matériel')">+</button>
                        <button class="button" onclick="removeFromCart('Trousse de Premiers Secours', 30, 'matériel')">-</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Loisirs -->
        <div class="section">
            <h2>Loisirs de Camping</h2>
            <div class="item-list">
                <div class="item">
                    <h3><i class="fas fa-hiking"></i> Randonnée</h3>
                    <p>Explorer les sentiers environnants. Prix: 10DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Randonnée', 10, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Randonnée', 10, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-fish"></i> Pêche</h3>
                    <p>Se détendre au bord d'un lac ou d'une rivière. Prix: 15DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Pêche', 15, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Pêche', 15, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-bicycle"></i> Vélo</h3>
                    <p>Faire des balades à vélo sur des chemins pittoresques. Prix: 20DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Vélo', 20, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Vélo', 20, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-star"></i> Observation des Étoiles</h3>
                    <p>Profiter de la nuit pour admirer le ciel. Prix: 8DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Observation des Étoiles', 8, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Observation des Étoiles', 8, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-users"></i> Jeux de Société</h3>
                    <p>Jouer à des jeux comme "Monopoly" ou "Uno". Prix: 5DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Jeux de Société', 5, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Jeux de Société', 5, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-chess"></i> Jeux de Cartes</h3>
                    <p>Faire une partie de poker, rami ou tarot. Prix: 5DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Jeux de Cartes', 5, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Jeux de Cartes', 5, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-volleyball-ball"></i> Sports de Plein Air</h3>
                    <p>Organiser un match de volley, frisbee ou badminton. Prix: 12DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Sports de Plein Air', 12, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Sports de Plein Air', 12, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-paint-brush"></i> Arts et Crafts</h3>
                    <p>Créer des objets avec des matériaux naturels. Prix: 10DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Arts et Crafts', 10, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Arts et Crafts', 10, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-camera-retro"></i> Photographie</h3>
                    <p>Capturer les paysages et moments mémorables. Prix: 15DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Photographie', 15, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Photographie', 15, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-book"></i> Lecture</h3>
                    <p>Profiter d'un bon livre au bord du feu. Prix: 5DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Lecture', 5, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Lecture', 5, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-spa"></i> Méditation</h3>
                    <p>Se relaxer en pleine nature. Prix: 5DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Méditation', 5, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Méditation', 5, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-fire"></i> Feu de Camp</h3>
                    <p>Rassembler les campeurs pour raconter des histoires. Prix: 10DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Feu de Camp', 10, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Feu de Camp', 10, 'loisir')">-</button>
                    </div>
                </div>
                <div class="item">
                    <h3><i class="fas fa-film"></i> Projection de Films</h3>
                    <p>Regarder un film en plein air avec un projecteur. Prix: 15DT</p>
                    <div class="button-container">
                        <button class="button" onclick="addToCart('Projection de Films', 15, 'loisir')">+</button>
                        <button class="button" onclick="removeFromCart('Projection de Films', 15, 'loisir')">-</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>© 2025 Camping Adventure. Tous droits réservés.</p>
        </div>
    </div>

    <!-- Panier visible -->
    <div class="cart" id="cart">
        <h2>Votre Panier</h2>
        <div id="cart-items"></div>
        <div class="total" id="cart-total">Total: 0DT</div>
    </div>

    <script>
        let cart = {
            matériel: [],
            loisir: []
        };
        let cartTotal = 0;

        function updateCartDisplay() {
            const cartItemsContainer = document.getElementById('cart-items');
            cartItemsContainer.innerHTML = ''; // Réinitialiser la liste des articles

            if (cart.matériel.length === 0 && cart.loisir.length === 0) {
                cartItemsContainer.innerHTML = '<p>Le panier est vide.</p>';
            } else {
                const categories = ['matériel', 'loisir'];

                categories.forEach(category => {
                    cart[category].forEach(item => {
                        const cartItemElement = document.createElement('div');
                        cartItemElement.classList.add('cart-item');
                        cartItemElement.innerText = `${item.name} - ${item.quantity} x ${item.price}DT`;
                        cartItemsContainer.appendChild(cartItemElement);
                    });
                });
            }

            document.getElementById('cart-total').innerText = `Total: ${cartTotal}DT`;
        }

        function addToCart(name, price, category) {
            const itemIndex = cart[category].findIndex(item => item.name === name);
            if (itemIndex > -1) {
                cart[category][itemIndex].quantity++;
            } else {
                cart[category].push({ name, price, quantity: 1 });
            }
            cartTotal += price;
            updateCartDisplay();
        }

        function removeFromCart(name, price, category) {
            const itemIndex = cart[category].findIndex(item => item.name === name);
            if (itemIndex > -1 && cart[category][itemIndex].quantity > 0) {
                cart[category][itemIndex].quantity--;
                cartTotal -= price;
                if (cart[category][itemIndex].quantity === 0) {
                    cart[category].splice(itemIndex, 1);
                }
            }
            updateCartDisplay();
        }
    </script>
</body>
</html>