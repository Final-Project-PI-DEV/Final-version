{% extends 'base.html.twig' %}

{% block title %}Log in!
{% endblock %}

{% block body %}
	<header id="header" class="header d-flex align-items-center fixed-top">
		<div class="container d-flex justify-content-center align-items-center">
			<a href="{{ path('sign-in') }}" class="logo d-flex align-items-center me-auto me-lg-0">
				<img src="{{ asset('assets/images/logorz1.png') }}" class="logo-img">
			</a>
			<nav id="navmenu" class="navmenu d-flex align-items-center">
				<ul class="d-flex align-items-center">
					<li>
						<a href="#" class="active">Home</a>
					</li>
					<li>
						<a href="{{ path('link1') }}">About</a>
					</li>
					<li>
						<a href="{{ path('link2') }}">Services</a>
					</li>
					<li>
						<a href="{{ path('link3') }}">Portfolio</a>
					</li>
					<li>
						<a href="#">Team</a>
					</li>
					<li>
						<a href="#">Contact</a>
					</li>
				</ul>
				<i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
			</nav>
			<a class="btn-getstarted" href="{{ path('app_user_new') }}">Get Started</a>
		</div>
	</header>

	<style>
		body {
			margin: 0;
			padding: 0;
			background-color: white;
			background-image: url('{{ asset('assets/images/campnow.jpg') }}');
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
		}

		.vh-100 {
			height: 100vh;
		}

		.d-flex {
			display: flex;
		}

		.justify-content-center {
			justify-content: center;
		}

		.align-items-center {
			align-items: center;
		}

		.card {
			border-radius: 10px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			background-color: rgba(0, 0, 0, 0.7); /* Fond sombre transparent */
			backdrop-filter: blur(5px);
			padding: 20px;
			color: white; /* Couleur du texte pour qu'il soit lisible sur fond sombre */
			margin-top: 50px; /* Ajouter un espace entre la navbar et le formulaire */
			width: 400px;
		}

		input[type="email"],
		input[type="password"] {
			padding: 10px;
			border: 1px solid #ccc;
			border-radius: 5px;
			transition: border 0.3s ease;
			width: 100%; /* Largeur complète pour les champs */
			box-sizing: border-box; /* Inclure padding et border dans la largeur */
			background-color: rgba(255, 255, 255, 0.8); /* Fond légèrement transparent pour les champs */
			color: black; /* Couleur du texte */
		}

		input:focus {
			border-color: #007bff;
			outline: none;
		}

		button {
			width: 100%;
			padding: 10px;
			background-color: #007bff;
			color: white;
			border: none;
			border-radius: 5px;
			font-size: 16px;
			cursor: pointer;
			transition: background-color 0.3s ease;
		}

		button:hover {
			background-color: #0056b3;
		}

		label {
			color: white; /* Texte blanc pour les labels */
			font-weight: bold;
			margin-bottom: 10px; /* Ajout d'un espace sous le label */
		}

		.checkbox label {
			color: white; /* Texte blanc pour les labels des cases à cocher */
		}

		.alert-danger {
			color: #721c24;
			background-color: #f8d7da;
			border-color: #f5c6cb;
			padding: 10px;
			border-radius: 5px;
			margin-bottom: 20px;
		}
	</style>

	<div class="d-flex justify-content-center align-items-center vh-100">
		<div class="card p-4">
			<form method="post">
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				{% if app.user %}
					<div class="mb-3">
						You are logged in as
						{{ app.user.userIdentifier }},
						<a href="{{ path('app_logout') }}">Logout</a>
					</div>
				{% endif %}

				<h1 class="h3 mb-3 font-weight-normal text-center">Please sign in</h1>

				<div class="form-outline">
					<label for="inputEmail">Email</label>
					<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
				</div>

				<div class="form-outline">
					<label for="inputPassword">Password</label>
					<input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
				</div>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<div class="checkbox mb-3">
					<label>
						<input type="checkbox" name="_remember_me">
						Remember me
					</label>
					<a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
				</div>

				<button class="btn btn-lg btn-primary" type="submit">
					Sign in
				</button>
			</form>
		</div>
	</div>
{% endblock %}
