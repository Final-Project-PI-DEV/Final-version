<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Campers Dashboard</title>
		<link rel="shortcut icon" href="{{ asset('assets/images/logo.png') }}">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
		<style>
			/* Table Styling */
			.admin-table {
				width: 100%;
				border-collapse: collapse;
				margin-top: 20px;
				background: white;
				border-radius: 8px;
				overflow: hidden;
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			}
			.admin-table th,
			.admin-table td {
				padding: 12px;
				text-align: left;
				border-bottom: 1px solid #ddd;
			}
			.admin-table th {
				background-color: #7380EC; /* Theme Green */
				color: white;
			}
			.admin-table tr:hover {
				background-color: #f5f5f5;
			}
			.btn-sm {
				padding: 6px 10px;
				border-radius: 4px;
				font-size: 14px;
				text-decoration: none;
				margin-right: 5px;
			}
			.btn-danger {
				background: #d33;
				color: white;
			}
			.btn-primary {
				background: #7380EC;
				color: white;
			}
			.comment-section {
				margin-left: 20px;
				border-left: 3px solid #4CAF50;
				padding-left: 10px;
			}
			.comment-section ul li {
				margin-bottom: 15px; /* Adjust the spacing as needed */


			}
		</style>
	</head>
	<body>
		<header>
			<div class="logo" title="University Management System">
				<img src="{{ asset('assets/images/logo.png') }}" alt="">
			</div>
			<div class="navbar">
				<a href={{path('app_user_index')}}  onclick="timeTableAll()">
					<span class="material-icons-sharp">home</span>
					<h3>User</h3>
				</a>
				<a href={{path('app_list')}} onclick="timeTableAll()">
					<span class="material-icons-sharp">event_available</span>
					<h3>RECLAMATION</h3>
				</a>
				<a href="/restaurant" onclick="timeTableAll()">
					<span class="material-icons-sharp">restaurant</span>
					<h3>RESTAURANTS</h3>
				</a>
				<a href="/menu">
					<span class="material-icons-sharp">menu</span>
					<h3>MENU</h3>
				</a>
				<a href="/dashboardAdmin" class="active">
					<span class="material-icons-sharp">article</span>
					<h3>Blog</h3>
				</a>
				<a href="/events">
					<span class="material-icons-sharp">events</span>
					<h3>events</h3>
				</a>
				<a href="/transport">
					<span class="material-icons-sharp">directions_bus</span>

					<h3>transports</h3>
				</a>

				<a href="{{path('app_logout')}}">
					<span class="material-icons-sharp">logout</span>
					<h3>Logout</h3>
				</a>
			</div>
			<div id="profile-btn">
				<span class="material-icons-sharp">person</span>
			</div>
			<div class="theme-toggler">
				<span class="material-icons-sharp active">light_mode</span>
				<span class="material-icons-sharp">dark_mode</span>
			</div>
		</header>

		<div class="container">
			<aside>
				<div class="profile">
					<div class="top">
						<div class="profile-photo">
							<img src="{{ admin.image ? asset('uploads/' ~ admin.image) : asset('assets/images/default-avatar.png') }}" alt="User Photo">
						</div>
						<div class="info">
							<p>Hey,
								<b>{{ admin.nom ~ ' ' ~ admin.prenom }}</b>
							</p>
							<small class="text-muted">12102030</small>
						</div>
					</div>
				</div>
			</aside>

			<main>
				<h1>Participation</h1>
				<div
					class="subjects"><!-- Existing participation blocks (kept unchanged) -->
				</div>

				<!-- 📌 BLOG MANAGEMENT SECTION STARTS HERE -->
				<h2 class="mt-4">Manage Blog Posts & Comments</h2>

				<table class="admin-table">
					<thead>
						<tr>
							<th>Titre</th>
							<th>Contenu</th>
							<th>Like</th>
							<th>Date de creation</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for post in posts %}
							<tr>
								<td>{{ post.title }}</td>
								<td>{{ post.content }}</td>
								<td>{{ post.likes }}</td>
								<td>{{ post.createdAt|date_modify("+1 hour")|date('Y-m-d H:i') }}</td>
								<td>
									<a href="{{ path('delete_post', {id: post.id}) }}" class="btn-sm btn-danger delete-btn" data-post-title="{{ post.title }}">
										Supprimer
									</a>
									<button class="btn-sm btn-primary toggle-comments" data-post-id="{{ post.id }}">
										Details
									</button>
								</td>
							</tr>

							<!-- Comments Section - Initially Hidden -->
							<tr id="comments-{{ post.id }}" class="comments-row" style="display: none;">
								<td colspan="5" class="comment-section">
									<strong>Comments:</strong>
									<ul>
										{% for comment in post.comments %}
											<li>
												<strong>{{ comment.createdAt|date_modify("+1 hour")|date('Y-m-d H:i') }}</strong>
												-
												{{ comment.content }}
												<a href="{{ path('delete_comment', {id: comment.id}) }}" class="btn-sm btn-danger delete-comment-btn" data-comment-id="{{ comment.id }}">
													🗑 Supprimer
												</a>
											</li>
										{% else %}
											<li class="text-muted">No comments yet</li>
										{% endfor %}
									</ul>
								</td>
							</tr>
						{% endfor %}
					</tbody>

				</table>
				<!-- 📌 BLOG MANAGEMENT SECTION ENDS HERE -->

				<div
					class="timetable" id="timetable"><!-- Existing timetable section (kept unchanged) -->
				</div>
			</main>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

		<script>
			document.addEventListener('DOMContentLoaded', function () { // Confirm post deletion
document.querySelectorAll('.delete-btn').forEach(button => {
button.addEventListener('click', function (e) {
e.preventDefault();
const postTitle = this.dataset.postTitle;
const deleteUrl = this.href;

Swal.fire({
title: `Delete "${postTitle}"?`,
icon: "warning",
showCancelButton: true,
confirmButtonColor: "#3085d6",
cancelButtonColor: "#d33",
confirmButtonText: "Yes, delete!",
cancelButtonText: "Cancel"
}).then((result) => {
if (result.isConfirmed) {
window.location.href = deleteUrl;
}
});
});
});

// Confirm comment deletion
document.querySelectorAll('.delete-comment-btn').forEach(button => {
button.addEventListener('click', function (e) {
e.preventDefault();
const deleteUrl = this.href;

Swal.fire({
title: "Voulez-vous vraiment supprimer ce commentaire ?",
icon: "warning",
showCancelButton: true,
confirmButtonColor: "#3085d6",
cancelButtonColor: "#d33",
confirmButtonText: "Oui, supprimer !",
cancelButtonText: "Annuler"
}).then((result) => {
if (result.isConfirmed) {
fetch(deleteUrl, {
method: "POST", // Ensures it sends as a form request
headers: {
"X-Requested-With": "XMLHttpRequest"
}
}).then(response => {
if (response.ok) {
window.location.reload(); // ✅ Reloads to Symfony's redirected page
} else {
console.error("Error deleting comment.");
}
}).catch(error => console.error("Fetch error:", error));
}
});
});
});
});

document.addEventListener("DOMContentLoaded", function () {
document.querySelectorAll(".toggle-comments").forEach(button => {
button.addEventListener("click", function () {
const postId = this.getAttribute("data-post-id");
const commentRow = document.getElementById(`comments-${postId}`);

if (commentRow.style.display === "none") {
commentRow.style.display = "table-row";
this.textContent = "Masquer";
} else {
commentRow.style.display = "none";
this.textContent = "Details";
}
});
});
});
		</script>

	</body>
</html>
