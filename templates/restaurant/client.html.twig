        }

        .status {
            display: block;
            width: fit-content;
            margin: 5px auto;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .status.actif {
            background: var(--accent-color);
            color: white;
        }

        .status.inactif {
            background: var(--danger-color);
            color: white;
        }

        .restaurant-email {
            font-size: 14px;
            color: var(--secondary-color);
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .restaurant-email i {
            font-size: 18px;
            margin-right: 5px;
            color: var(--primary-color);
        }

        .btn {
            display: inline-block;
            padding: 10px 15px;
            background: var(--accent-color);
            color: white;
            border: none;
            border-radius: 5px;
            text-align: center;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.3s ease;
            text-decoration: none;
        }

        .btn:hover {
            background: var(--secondary-color);
        }

        .menu-container {
            margin-top: 15px;
            padding: 10px;
            background: #f9f9f9;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            display: none;
        }

        .menu-container h3 {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .menu-container ul {
            list-style: none;
            padding: 0;
        }

        .menu-container ul li {
            padding: 5px 0;
            font-size: 14px;
        }

        .menu-container ul li a {
            text-decoration: none;
            color: var(--primary-color);
            font-weight: bold;
        }

        .menu-container ul li a:hover {
            color: var(--accent-color);
        }

        .btn-quantity {
            background: var(--accent-color);
            color: white;
            border: none;
            border-radius: 5px;
            padding: 5px 10px;
            font-size: 14px;
            cursor: pointer;
            margin: 5px;
            transition: background 0.3s;
        }

        .btn-quantity:hover {
            background: var(--secondary-color);
        }

        .quantity {
            font-size: 16px;
            font-weight: bold;
            margin: 0 10px;
        }

        .total-price {
            font-size: 18px;
            font-weight: bold;
            margin-top: 10px;
        }
        .restaurant-section {
             display: flex;
             gap: 20px;
             justify-content: center;
             margin-bottom: 50px;
        }

