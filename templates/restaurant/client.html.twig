            font-size: 16px;
            width: 100%;
            padding: 10px;
            background: transparent;
        }
        .average-rating {
            font-weight: bold;
            color: #18BC9C; /* Couleur verte pour la note moyenne */
        }

        .rating-count {
            font-style: italic;
            color: #666; /* Couleur grise pour le nombre d'avis */
        }        



        .star-rating {
            display: flex;
            flex-direction: center; /* Pour afficher les étoiles de droite à gauche */
            justify-content: center;
            gap: 5px;
        }

        .star-rating input {
            display: none; /* Masquer les boutons radio */
        }

        .star-rating label {
            cursor: pointer;
            color: #ccc; /* Couleur des étoiles non sélectionnées */
            transition: color 0.2s;
        }

        .star-rating input:checked ~ label,
        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #ffc107; /* Couleur des étoiles sélectionnées ou survolées */
        }

        /* Section des restaurants */
        .restaurant-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .restaurant-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 300px;
            transition: transform 0.3s ease-in-out;
            text-align: center;
            padding-bottom: 15px;
            
        }

        .restaurant-card:hover {
            transform: scale(1.05);
        }

        .restaurant-image img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .restaurant-content {
            padding: 15px;
        }

        .restaurant-content h2 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .restaurant-content p {
