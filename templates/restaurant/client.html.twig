                }
        .total-general-container {
            text-align: center; /* Centre le texte */
            font-size: 24px; /* Augmente la taille du texte */
            font-weight: bold; /* Met le texte en gras */
            color: black; /* Assure que la couleur est correcte */
            background: white; /* Ajoute un fond blanc */
            padding: 15px; /* Ajoute un peu d'espace autour */
            border-radius: 10px; /* Arrondit les bords */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Ajoute une ombre légère */
            width: fit-content; /* Ajuste la largeur au contenu */
            margin: 2
        
        }
        .button {
        position: relative;
        overflow: hidden;
        height: 3rem;
        padding: 0 2rem;
        border-radius: 1.5rem;
        background: #3d3a4e;
        background-size: 400%;
