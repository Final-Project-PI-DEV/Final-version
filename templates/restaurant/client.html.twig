{% block body %}
  <body>
    {{include('reclamation/index1.html.twig')}}
        <main class="main container mt-5">



            <!-- Section des fonctionnalités -->
            <section class="restaurant-section">
                <div class="card">
                    <div class="icon">
                        <i class="fas fa-utensils"></i>
                        <i class="fas fa-coffee"></i>
                        <i class="fas fa-ice-cream"></i>
                    </div>
                    <h3>Camping et bons plats, l’aventure parfaite</h3>
                    <p>des restaurants dans tous les styles, de la cuisine de rue à la gastronomie</p>
                </div>

                <div class="card">
                    <div class="icon">
                        <img src="https://randomuser.me/api/portraits/thumb/women/1.jpg" alt="user">
                        <img src="https://randomuser.me/api/portraits/thumb/men/2.jpg" alt="user">
                        <img src="https://randomuser.me/api/portraits/thumb/women/3.jpg" alt="user">
                    </div>
                    <h3>Voir les derniers avis</h3>
                    <p>Des millions de photos et d’avis sur les restaurants de notre communauté mondiale de campers</p>
                </div>

                <div class="card">
                    <div class="icon">
                        <i class="fas fa-concierge-bell"></i>
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3>Dînez sous les étoiles, commandez dès maintenant !</h3>
                    <p>Commandez en ligne et régalez-vous en camping</p>
                </div>
            </section>
            <a href="{{ path('app_restaurant_accueil') }}" class="btn btn-primary">
                Voir recommandations
            </a>


<!-- Section des restaurants -->
        <h2 class="text-center">Campez mieux avec nos restaurants.</h2>
        <div class="restaurant-container">
            {% for restaurant in restaurants %}
                <div class="restaurant-card">
                    <div class="restaurant-image">
                        {% if restaurant.image %}
                            <img src="{{ asset('uploads/restaurants/' ~ restaurant.image) }}" alt="{{ restaurant.nomResto }}">
                        {% else %}
                            <p>Aucune image disponible</p>
                        {% endif %}
                    </div>

                    <form class="rating-form" action="{{ path('app_restaurant_rate', {'id': restaurant.id}) }}" method="POST" data-restaurant-id="{{ restaurant.id }}">
                            <div class="form-group">
                                <div class="star-rating">
                                    {% for i in 5..1 %}
                                        <input type="radio" id="star-{{ restaurant.id }}-{{ i }}" name="rating" value="{{ i }}" />
                                        <label for="star-{{ restaurant.id }}-{{ i }}" title="{{ i }} étoiles">
                                            <i class="fas fa-star"></i>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Noter</button>
                    </form>                    


                    <div class="restaurant-content">
                        <h2>{{ restaurant.nomResto }}</h2>
                        <p>{{ restaurant.description }}</p>
                        <p>{{ restaurant.email }}</p>
                        <span class="status {{ restaurant.statut|lower }}">{{ restaurant.statut }}</span>

                        <!-- Formulaire de notation -->
                        <form class="rating-form" action="{{ path('app_restaurant_rate', {'id': restaurant.id}) }}" method="POST" data-restaurant-id="{{ restaurant.id }}">
                            <div class="form-group">
                                <label>Noter ce restaurant</label>
                                <div class="star-rating">
                                    {% for i in 5..1 %}
                                        <input type="radio" id="star-{{ restaurant.id }}-{{ i }}" name="rating" value="{{ i }}" />
                                        <label for="star-{{ restaurant.id }}-{{ i }}" title="{{ i }} étoiles">
                                            <i class="fas fa-star"></i>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Noter</button>
                        </form>

                        <!-- Affichage de la note moyenne -->
                        <p>Note moyenne : <span class="average-rating">{{ restaurant.averageRating ?? 'Pas encore noté' }}</span>/5 (<span class="rating-count">{{ restaurant.ratingCount }}</span> avis)</p>

                        <!-- Bouton "Voir Plus" et section des menus -->
                        <button class="btn voir-plus" data-id="{{ restaurant.id }}">Voir Plus</button>
                        <div class="menu-container" id="menu-{{ restaurant.id }}">
                            <h3>Menus disponibles</h3>
                            {% if restaurant.menu is not empty %}
                                <ul>
                                    {% for menu in restaurant.menu %}
                                        <li>
                                            <span>{{ 'menu.repas' }} - <strong>{{ menu.prix }} €</strong></span>
                                            <button class="btn-quantity btn-minus" data-price="{{ menu.prix }}">-</button>
                                            <span class="quantity" data-price="{{ menu.prix }}">0</span>
                                            <button class="btn-quantity btn-plus" data-price="{{ menu.prix }}">+</button>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p>Aucun menu disponible pour ce restaurant.</p>
                            {% endif %}
                            <p class="total-price">Total: <strong><span class="total">0</span> €</strong></p>
                            <button class="button"><span class="btn-commander" data-restaurant-id="{{ restaurant.id }}">Commander</span></button>

                        </div>
                    </div>
                </div>
            {% endfor %} 
        </div>
        
    </main>
  </body>
{% endblock %}
{% block javascripts %}
    <!-- Charger TensorFlow.js -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <!-- Charger le modèle MobileNet -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Gestion des formulaires de notation
            const imageUpload = document.getElementById('image-upload');
            const resultDiv = document.getElementById('result');
            document.querySelectorAll(".rating-form").forEach(form => {
                form.addEventListener("submit", function (e) {
                    e.preventDefault(); // Empêche le rechargement de la page

                    const restaurantId = this.getAttribute("data-restaurant-id");
                    const selectedRating = this.querySelector("input[name='rating']:checked");

                    if (!selectedRating) {
                        alert("Veuillez sélectionner une note avant de soumettre.");
                        return;
                    }

                    const formData = new FormData(this);
                    formData.set("rating", selectedRating.value); // Ajouter la note sélectionnée au formulaire

                    fetch(this.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest', // Indique que c'est une requête AJAX
                        },
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Mettre à jour l'affichage de la note moyenne
                            const card = this.closest(".restaurant-card");
                            card.querySelector(".average-rating").textContent = data.averageRating.toFixed(1);
                            card.querySelector(".rating-count").textContent = data.ratingCount;

                            // Afficher un message de succès
                            alert("Merci pour votre notation !");
                        } else {
                            // Afficher un message d'erreur
                            alert(data.message);
                        }
                    })
                    .catch(error => {
                        console.error("Erreur lors de la soumission du formulaire : ", error);
                        alert("Une erreur s'est produite. Veuillez réessayer.");
                    });
                });
            });

            // Gestion des boutons "Voir Plus" et des menus
            document.querySelectorAll(".voir-plus").forEach(button => {
                button.addEventListener("click", function () {
                    let restaurantId = this.getAttribute("data-id");
                    let menuContainer = document.getElementById("menu-" + restaurantId);

                    // Afficher ou masquer le menu
                    if (menuContainer.style.display === "none" || menuContainer.style.display === "") {
                        menuContainer.style.display = "block";
                        this.textContent = "Masquer";
                    } else {
                        menuContainer.style.display = "none";
                        this.textContent = "Voir Plus";
                    }
                });
            });

            // Gestion des boutons + et -
            document.querySelectorAll(".btn-plus").forEach(button => {
                button.addEventListener("click", function () {
                    let quantityElem = this.previousElementSibling;
                    let price = parseFloat(this.getAttribute("data-price"));
                    let quantity = parseInt(quantityElem.textContent);
                    
                    quantityElem.textContent = quantity + 1;
                    updateTotal(this.closest(".menu-container"));
                });
            });

            document.querySelectorAll(".btn-minus").forEach(button => {
                button.addEventListener("click", function () {
                    let quantityElem = this.nextElementSibling;
                    let price = parseFloat(this.getAttribute("data-price"));
                    let quantity = parseInt(quantityElem.textContent);

                    if (quantity > 0) {
                        quantityElem.textContent = quantity - 1;
                        updateTotal(this.closest(".menu-container"));
                    }
                });
            });

            function updateTotal(menuContainer) {
                let totalElem = menuContainer.querySelector(".total");
                let total = 0;

                menuContainer.querySelectorAll(".quantity").forEach(qtyElem => {
                    let quantity = parseInt(qtyElem.textContent);
                    let price = parseFloat(qtyElem.getAttribute("data-price"));
                    total += quantity * price;
                });

                totalElem.textContent = total.toFixed(2);
                updateTotalGeneral(); // Mise à jour du total général
            }

            function updateTotalGeneral() {
                let totalGeneral = 0;
                document.querySelectorAll(".total").forEach(totalElem => {
                    totalGeneral += parseFloat(totalElem.textContent);
                });
                document.getElementById("total-general").textContent = totalGeneral.toFixed(2);
            }
            // Gestion du bouton "Commander"
            document.querySelectorAll(".btn-commander").forEach(button => {
                button.addEventListener("click", function () {
                    const restaurantId = this.getAttribute("data-restaurant-id");
                    const menuContainer = this.closest(".menu-container");

                    // Récupérer les menus sélectionnés
                    const menus = [];
                    menuContainer.querySelectorAll(".quantity").forEach(qtyElem => {
                        const quantity = parseInt(qtyElem.textContent);
                        if (quantity > 0) {
                            const price = parseFloat(qtyElem.getAttribute("data-price"));
                            menus.push({
                                'name': qtyElem.previousElementSibling.textContent.trim(),
                                'quantity': quantity,
                                'price': price,
                            });
                        }
                    });

                    // Envoyer la commande au serveur
                    fetch("{{ path('app_restaurant_commander') }}", {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify({
                            'restaurant_id': restaurantId,
                            'menus': menus,
                        }),
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(`Commande validée ! ID de la commande : ${data.commandeId}\nTotal : ${data.total} €`);
                            // Réinitialiser les quantités
                            menuContainer.querySelectorAll(".quantity").forEach(qtyElem => {
                                qtyElem.textContent = 0;
                            });
                            updateTotal(menuContainer);
                        } else {
                            alert("Erreur lors de la commande. Veuillez réessayer.");
                        }
                    })
                    .catch(error => {
                        console.error("Erreur lors de la commande : ", error);
                        alert("Une erreur s'est produite. Veuillez réessayer.");
                    });
                });
            });
            // Réinitialiser les quantités
            menuContainer.querySelectorAll(".quantity").forEach(qtyElem => {
                qtyElem.textContent = 0;
            });
            updateTotal(menuContainer);


            imageUpload.addEventListener('change', function (event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = new Image();
                        img.src = e.target.result;

                        img.onload = function () {
                            // Charger le modèle MobileNet
                            mobilenet.load().then(model => {
                                // Classer l'image
                                model.classify(img).then(predictions => {
                                    // Afficher les résultats
                                    resultDiv.innerHTML = '<h3>Résultats :</h3>';
                                    predictions.forEach(prediction => {
                                        resultDiv.innerHTML += `<p>${prediction.className} (${Math.round(prediction.probability * 100)}%)</p>`;
                                    });

                                    // Rechercher des restaurants proposant ce plat
                                    const dishName = predictions[0].className.split(',')[0]; // Prendre la première prédiction
                                    fetch(`/search-restaurants?dish=${encodeURIComponent(dishName)}`)
                                        .then(response => response.json())
                                        .then(data => {
                                            if (data.restaurants.length > 0) {
                                                resultDiv.innerHTML += '<h3>Restaurants proposant ce plat :</h3>';
                                                data.restaurants.forEach(restaurant => {
                                                    resultDiv.innerHTML += `<p>${restaurant.nomResto} - <a href="/restaurant/${restaurant.id}">Voir le restaurant</a></p>`;
                                                });
                                            } else {
                                                resultDiv.innerHTML += '<p>Aucun restaurant trouvé pour ce plat.</p>';
                                            }
                                        });
                                });
                            });
                        };
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>         
{% endblock %} 
