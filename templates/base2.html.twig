{# templates/base.html.twig #}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Bienvenue!{% endblock %}</title>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
        <link rel="icon" href="{{ asset('assets/img/logorz11.png') }}" type="image/x-icon">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">   
      <style>
            /* Updated navbar design */
            .navbar {
                background: rgba(51, 51, 51, 0.7) !important; /* Grey with light opacity */
            }
            .navbar .nav-link {
                color: white !important;
                padding: 10px 15px;
                border-radius: 10px;
                transition: background 0.3s ease-in-out;
            }
            .navbar .nav-link:hover {
                background: #FF883B;
                color: white !important;
            }
            .navbar-nav .nav-item {
    margin-right: 20px; /* Ajuste la valeur pour plus ou moins d'espace */
}
.navbar .nav-link.active {
    color: white !important; /* Keep text white */
    background: #FF883B !important; /* Orange background */
    border-radius: 10px; /* Keep rounded corners */
    padding: 10px 15px; /* Ensure consistent spacing */
    transition: background 0.3s ease-in-out;
}

.logout-button {
    font-size: 14px; /* Small text */
    color: #ccc !important; /* Subtle grey color */
    transition: color 0.3s ease-in-out;
}

.logout-button:hover {
    color: #fff !important; /* White on hover */
}
        </style>
        {% block stylesheets %}{% endblock %}
       {% block javascripts %}
    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
    </head>
    <body>
      <nav class="navbar navbar-expand-lg navbar-light">
    <div class="container">
        {# Brand + Toggler (left side) #}
        <div class="d-flex align-items-center">
            <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
                <img src="{{ asset('assets/img/logorz11.png')  }}" alt="Logo" style="height: 61px; margin-right: 15px;">
              
        
        </div>
        
        {# Collapsible Content (right side) #}
        <div class="collapse navbar-collapse flex-grow-0" id="navbarNav">
            <ul class="navbar-nav me-auto me-lg-0">  {# Left-aligned items #}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('home11') }}">
                        Home
                    </a>
                </li>
                <li class="nav-item">
						<a class="nav-link" href="{{path('app_restaurant_front')}}">Restaurant</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="{{path('user-liste')}}">Mes reclamations</a>
					</li>
					<li class="nav-item">
						<a  class="nav-link" href="{{path('create-reclamation')}}">Contact</a>
					</li>
                
               
               <li class="nav-item">
    <a class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}" 
       href="{{ path('app_home') }}">
        Blog
    </a>
</li>            
               <li class="nav-item">
    <a class="nav-link {% if app.request.get('_route') == 'app_createPost' %}active{% endif %}" 
       href="{{ path('app_createPost') }}">
       <i class="fas fa-plus-circle me-2"></i> Ajouter un Post
    </a>
</li>

            </ul>
           <ul class="navbar-nav ms-auto">
    {% if app.user %}
        <li class="nav-item">
            <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                <button type="submit" class="btn btn-link text-white text-decoration-none small logout-button">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </button>
            </form>
        </li>
    {% endif %}
</ul>
        </div>
    </div>
</nav>
        <div class="container mt-4">
        {% for message in app.flashes('message') %}
            <div class="alert alert-success flash-message">
                {{ message }}
            </div>
        {% endfor %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        setTimeout(function() {
            let flashMessages = document.querySelectorAll(".flash-message");
            flashMessages.forEach(function(message) {
                message.style.transition = "opacity 1s";
                message.style.opacity = "0";
                setTimeout(() => message.style.visibility = "hidden", 1000);
            });
        }, 1000); 
    });
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    let lastScrollTop = 0;
    const navbar = document.querySelector(".navbar");

    window.addEventListener("scroll", function () {
        let scrollTop = window.scrollY || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Scroll vers le bas : cacher la navbar
            navbar.style.transform = "translateY(-100%)";
            navbar.style.transition = "transform 0.2s ease-in-out";
        } else {
            // Scroll vers le haut : afficher la navbar
            navbar.style.transform = "translateY(0)";
        }

        lastScrollTop = scrollTop;
    });
});
</script>

            {% block body %}{% endblock %}
        </div>
    </body>
</html>
