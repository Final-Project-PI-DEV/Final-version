<style>
.footer {
  position: relative;
  overflow: hidden;
  padding: 50px 0;
  background: #2d2d2d;
  color: white;
}

.footer__parralax {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.footer__parralax-trees { /* Styles spécifiques pour l'animation parallax */ }
.footer__parralax-moto { /* Styles spécifiques pour l'animation parallax */ }
.footer__parralax-secondplan { /* Styles spécifiques pour l'animation parallax */ }
.footer__parralax-premierplan { /* Styles spécifiques pour l'animation parallax */ }
.footer__parralax-voiture { /* Styles spécifiques pour l'animation parallax */ }

.footer__columns {
