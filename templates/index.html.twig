}

.footer__copyrights {
  margin-top: 50px;
  text-align: center;
  position: relative;
  z-index: 2;
}

/* Styles pour les animations parallax */
@media (max-width: 768px) {
  .footer__columns {
    grid-template-columns: 1fr;
  }
}
</style>
